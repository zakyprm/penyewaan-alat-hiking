# Salin file ini menjadi .env lalu isi nilainya. Jangan commit .env.

# --- Database (PostgreSQL: Docker lokal atau Neon) ---
# Nilai default di bawah cocok dengan docker-compose.yml
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sewa_hiking?schema=public"
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/sewa_hiking_test?schema=public"

# --- Akun admin awal yang dibuat oleh `npm run db:seed` ---
# Password minimal 8 karakter. Ganti sebelum dipakai di luar lokal.
SEED_ADMIN_EMAIL="admin@sewahiking.test"
SEED_ADMIN_PASSWORD="admin12345"

# --- Aplikasi ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Better Auth ---
# Buat dengan: npx @better-auth/cli secret  (atau string acak minimal 32 karakter)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Midtrans (gunakan kunci sandbox saat pengembangan) ---
MIDTRANS_SERVER_KEY=""
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# --- Vercel Blob (foto alat) ---
# Tidak perlu diisi manual. Vercel menyuntikkan kredensial OIDC otomatis ke Vercel Functions
# saat runtime setelah store Blob dihubungkan ke project di dashboard Vercel (Storage tab).
# Di development lokal, foto disimpan di folder storage/uploads/ (tidak butuh Blob sama sekali).

# --- Cron (header Authorization: Bearer <CRON_SECRET>) ---
CRON_SECRET=""
